Chip Name:	Memory	        // Complete memory address space
Inputs:		in[16],		// What to write
		load,           // Write-enable bit
		address[15]     // Where to write
Output:		out[16]         // Memory value at the given address
Function:	1. out(t)=Memory[address(t)](t)
		2. If load(t-1) then Memory[address(t-1)](t)=in(t-1)
		(t is the current time unit, or cycle)
Comment:	Access to any address>24576 (0x6000) is invalid.
		Access to any address in the range 16384-24575
		(0x4000-0x5FFF) results in accessing the screen
		memory map. Access to address 24576 (0x6000) results
		in accessing the keyboard memory map. The behavior
		in these addresses is described in the Screen and
		Keyboard chip specifications.

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    DMux4Way(in=load, sel=address[13..14], a=loadRamA, b=loadRamB, c=loadScreen);
    Or(a=loadRamA, b=loadRamB, out=loadRam);
    
    Mux4Way16(a=outRam, b=outRam, c=outScreen, d=outKeyboard, sel=address[13..14], out=out[0..15]);
    
    RAM16K(in=in[0..15] , load=loadRam , address=address[0..13] , out=outRam);
    Screen(in=in[0..15], load=loadScreen , address=address[0..12] , out=outScreen);
    Keyboard(out=outKeyboard);
